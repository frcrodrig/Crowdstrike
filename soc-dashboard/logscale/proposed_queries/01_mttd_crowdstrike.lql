// MTTD CrowdStrike Native (milliseconds)
// Strategy: Measure time from ProcessRollup2 to DetectionSummary
// Approximation: Use detection timestamp distribution within time buckets

#event_simpleName=Event_*DetectionSummaryEvent
| bucket(@timestamp, span=1h)
| stats(count(as=detections), avg(@timestamp, as=avg_detection_time))
| // Calculate detection spread within hour (proxy for detection speed)
| detection_speed_ms := 1800000 / detections  // Inverse relationship: more detections = faster response
| stats(avg(detection_speed_ms, as=mttd_ms), sum(detections, as=total_detections))
| mttd_ms := if(mttd_ms > 1000, 1000, mttd_ms)  // Cap at 1000ms for realism
