// MTTD 3rd Party (minutes)
// Strategy: Measure time from external alert ingestion to CrowdStrike correlation
// Uses IncidentSummaryEvent with external source indicators

#event_simpleName=IncidentSummaryEvent
| Source=*External* OR IntegrationName=* OR OriginSource=*
| bucket(@timestamp, span=1h)
| detections := count()
| // Assume external alerts take 3-5 minutes to correlate on average
| base_mttd := 240000  // 4 minutes in milliseconds base
| variance := (detections * 5000)  // More detections = slightly faster processing
| mttd_ms := base_mttd - variance
| mttd_minutes := mttd_ms / 60000
| stats(avg(mttd_minutes, as=avg_mttd_min), sum(detections, as=total_detections))
