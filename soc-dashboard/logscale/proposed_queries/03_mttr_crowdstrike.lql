// MTTR CrowdStrike (milliseconds) - Workflow Execution Time
// Strategy: Measure actual workflow execution duration from FusionWorkflowEvent

#event_simpleName=FusionWorkflowEvent
| status="Succeeded" OR status="Failed"
| WorkflowType=*response* OR WorkflowType=*remediate*
| execution_time_ms := (EndTime - StartTime)
| execution_time_ms > 0  // Filter invalid times
| execution_time_ms < 10000  // Cap at 10 seconds for automated response
| stats(avg(execution_time_ms, as=mttr_ms), count(as=total_workflows))
