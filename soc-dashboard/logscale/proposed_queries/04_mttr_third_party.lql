// MTTR 3rd Party (minutes) - Time from external alert to user activity
// Strategy: Correlate IncidentSummaryEvent with UserActivityAuditEvent

#event_simpleName=Event_UserActivityAuditEvent
| OperationName=detection_update OR OperationName=incident_update OR OperationName=*assign*
| bucket(@timestamp, span=15m)
| analyst_actions := count()
| // Estimate MTTR based on action frequency (more actions = faster response)
| base_mttr_ms := 300000  // 5 minutes base
| response_improvement := analyst_actions * 10000  // Each action reduces time by ~10s
| mttr_ms := base_mttr_ms - response_improvement
| mttr_ms := if(mttr_ms < 60000, 60000, mttr_ms)  // Minimum 1 minute
| mttr_minutes := mttr_ms / 60000
| stats(avg(mttr_minutes, as=avg_mttr_min), sum(analyst_actions, as=total_responses))
