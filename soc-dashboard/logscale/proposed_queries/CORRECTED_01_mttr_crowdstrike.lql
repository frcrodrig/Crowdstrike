// MTTR CrowdStrike - CORREGIDA
// Usa start_timestamp y end_timestamp (campos reales)

#event_simpleName=FusionWorkflowEvent
| status="Succeeded" OR status="Failed"
| definition_name=*response* OR definition_name=*remediate* OR definition_name=*Remediation*
| execution_time_ms := (end_timestamp - start_timestamp) / 1000  // Convertir a ms
| execution_time_ms > 0
| execution_time_ms < 10000  // Menos de 10 segundos
| stats(avg(execution_time_ms, as=mttr_ms), count(as=total_workflows))
