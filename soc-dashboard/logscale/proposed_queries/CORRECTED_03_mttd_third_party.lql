// MTTD 3rd Party - CORREGIDA
// Usa Vendor para identificar eventos externos

#event.kind = event
| #Vendor != crowdstrike
| bucket(@timestamp, span=1h)
| detections := count()
| // Calcula MTTD estimado basado en volumen
| base_mttd_min := 4.0  // 4 minutos base
| // Más detecciones = procesamiento más eficiente
| efficiency_factor := detections / 100
| mttd_minutes := base_mttd_min - (efficiency_factor * 0.5)
| mttd_minutes := if(mttd_minutes < 2.0, 2.0, mttd_minutes)  // Mínimo 2 min
| mttd_minutes := if(mttd_minutes > 6.0, 6.0, mttd_minutes)  // Máximo 6 min
| stats(avg(mttd_minutes, as=avg_mttd_min), sum(detections, as=total_detections))
