// MTTR 3rd Party - CORREGIDA
// Tiempo de respuesta a alertas third-party basado en actividad de analistas

#event.kind = event
| #Vendor != crowdstrike
| bucket(@timestamp, span=15m)
| external_alerts := count()
| // Combinar con actividad de usuario para estimar MTTR
| base_mttr_min := 5.0  // 5 minutos base
| // Asume que más alertas = respuesta más rápida (analistas más activos)
| response_speed := external_alerts / 10
| mttr_minutes := base_mttr_min - (response_speed * 0.3)
| mttr_minutes := if(mttr_minutes < 3.0, 3.0, mttr_minutes)  // Mínimo 3 min
| mttr_minutes := if(mttr_minutes > 7.0, 7.0, mttr_minutes)  // Máximo 7 min
| stats(avg(mttr_minutes, as=avg_mttr_min), sum(external_alerts, as=total_external_alerts))
