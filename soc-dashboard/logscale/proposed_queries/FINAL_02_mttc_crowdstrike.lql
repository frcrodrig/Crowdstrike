// MTTC CrowdStrike - SINTAXIS CORRECTA
#event_simpleName=FusionWorkflowEvent
| status="Succeeded"
| definition_name=/contain|isolate|quarantine|isolation/i
| parseTimestamp(field=start_timestamp, as=start_ts)
| parseTimestamp(field=end_timestamp, as=end_ts)
| execution_time_ms := end_ts - start_ts
| test(execution_time_ms > 0)
| test(execution_time_ms < 5000)
| stats([avg(execution_time_ms, as=mttc_ms), count(as=total_containments)])
