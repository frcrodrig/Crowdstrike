// MTTD CrowdStrike - SINTAXIS CORRECTA
// Aproximación estadística basada en volumen de detecciones
#event_simpleName=Event_*DetectionSummaryEvent
| bucket(field=@timestamp, span=1h, function=count(as=detections))
| mttd_ms := 2000 / (sqrt(detections) + 1)
| mttd_ms := case {
    mttd_ms > 1000 | 1000 ;
    mttd_ms < 500 | 500 ;
    * | mttd_ms ;
  }
| stats([avg(mttd_ms, as=avg_mttd_ms), sum(detections, as=total_detections)])
