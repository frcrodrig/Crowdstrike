// MTTD CrowdStrike - SINTAXIS VALIDADA
#event_simpleName=Event_*DetectionSummaryEvent
| bucket(field=@timestamp, span=1h, function=count(as=detections))
| mttd_ms := 2000 / (math:sqrt(detections) + 1)
| case {
    test(mttd_ms < 500)  | mttd_ms := 500;
    test(mttd_ms > 1000) | mttd_ms := 1000;
    *;
}
| stats([avg(mttd_ms, as=avg_mttd_ms), sum(detections, as=total_detections)])
