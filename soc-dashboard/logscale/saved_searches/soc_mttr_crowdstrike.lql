// MTTR CrowdStrike - SINTAXIS VALIDADA
#event_simpleName=FusionWorkflowEvent
| in(field=status, values=["Succeeded", "Failed"])
| definition_name=/response|remediate|remediation/i
| parseTimestamp(field=start_timestamp, as=start_ts)
| parseTimestamp(field=end_timestamp, as=end_ts)
| execution_time_ms := end_ts - start_ts
| test(execution_time_ms > 0)
| test(execution_time_ms < 10000)
| stats([avg(execution_time_ms, as=mttr_ms), count(as=total_workflows)])
