#repo=detections
| ExternalApiType=Event_IncidentSummaryEvent
| groupBy([IncidentID], function=selectLast([@timestamp, State, IncidentType, FineScore]))
| State=open
| case {
    FineScore >= 90 | severity_label := "Critical" ;
    FineScore >= 70 | severity_label := "High" ;
    FineScore >= 50 | severity_label := "Medium" ;
    * | severity_label := "Low" ;
  }
| groupBy(severity_label, function=count(as=count))
